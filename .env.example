PORT=4318
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:4318
# Set a strong instructor password. Run npm run setup to create a local .env.
ADMIN_PASSWORD=
# Configure privately; do not commit this key.
OPENROUTER_API_KEY=
# Choose a model available to your account that supports structured outputs.
OPENROUTER_MODEL=
# Restrict live requests to providers with documented zero data retention.
OPENROUTER_ZDR=true
DATA_DIR=./data
# Set true when serving through an HTTPS reverse proxy.
SECURE_COOKIES=false
# Default: trust no proxy. Behind the packaged Caddy proxy, use loopback/linklocal/uniquelocal.
TRUST_PROXY=
# Required on Vercel: pooled PostgreSQL connection string (Neon or compatible).
DATABASE_URL=
# Required on Vercel: a stable random 32-byte key encoded as 64 hex characters.
CQUIZ_ENCRYPTION_KEY=
# Optional Google sign-in. Create an OAuth "Web application" client ID in
# Google Cloud and add this site's address as an authorized JavaScript origin.
# When set, students join LIVE exams with Google; rehearsals keep email + ID.
GOOGLE_CLIENT_ID=
# Comma-separated Google emails allowed into the instructor workspace.
ADMIN_EMAILS=
# Optional: only accept these Google Workspace domains (e.g. g.clemson.edu).
GOOGLE_ALLOWED_DOMAINS=
# Optional: treat school domains as the same mailbox (e.g. g.clemson.edu=clemson.edu).
GOOGLE_EMAIL_ALIASES=
