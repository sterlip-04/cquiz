{
  "name": "cquiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run build && npm test",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.6",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/functions": "^3.10.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jose": "^6.2.13",
    "multer": "^2.0.2",
    "papaparse": "^5.5.3",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
